                FROM speakers
                WHERE 
                (english_name LIKE %s OR 
                chinese_name LIKE %s OR 
                year LIKE %s OR 
                bio LIKE %s)
            
                GROUP BY english_name, chinese_name, bio, year
                HAVING COUNT(DISTINCT pdf_url) > 0
                ORDER BY english_name DESC
         LIMIT %s OFFSET %s
