                    MIN(id) as id,
                    english_name, 
                    chinese_name, 
                    bio, 
                    year, 
                    GROUP_CONCAT(DISTINCT pdf_url ORDER BY pdf_url SEPARATOR '|') as pdf_urls
                FROM speakers
                WHERE 
